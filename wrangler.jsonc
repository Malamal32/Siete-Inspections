{
  "name": "siete-inspections",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siete-inspections",
      "database_id": "64246c40-846d-4181-9186-8d6bd321581c"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "siete-photos" }
  ]
}
